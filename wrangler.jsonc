{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ecrelay",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "ACCOUNT_POOL", "class_name": "AccountPool" },
      { "name": "PROXY_EXECUTOR", "class_name": "ProxyExecutor" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["AccountPool"] },
    { "tag": "v2", "new_sqlite_classes": ["ProxyExecutor"] }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.1,
      "invocation_logs": true,
      "persist": true
    }
  }
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "codex-oauth-proxy",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "ACCOUNT_POOL", "class_name": "AccountPool" },
      { "name": "PROXY_EXECUTOR", "class_name": "ProxyExecutor" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["AccountPool"] },
    { "tag": "v2", "new_sqlite_classes": ["ProxyExecutor"] }
  ],
  "vpc_networks": [
    {
      "binding": "NATIVE_EGRESS",
      // Replace this with your own Cloudflare Tunnel/VPC egress ID before deploying.
      "tunnel_id": "00000000-0000-4000-8000-000000000000",
      "remote": true
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.1,
      "invocation_logs": true,
      "persist": true
    }
  }
}
